<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <!-- No credential keys. Both builds: the ID + password are typed into the UI and
         persisted (DPAPI-encrypted, %LOCALAPPDATA%\GolfCatch\pw.dat) with the 저장 button
         or the "로그인 정보 저장" checkbox. Nothing about credentials is written to this file. -->
    <add key="UserCode" value="" />

    <!-- Two fixed booking-condition slots. Format: course,yyyymmdd,desiredHHMM,starter
         Leave blank to fill them in the UI (예약 1 / 예약 2 sections + 저장). -->
    <add key="Condition1" value="" />
    <add key="Condition2" value="" />

    <!-- Sequential-gate reservation-history page (best-effort default; validate live). -->
    <add key="HistoryUrl" value="https://www.sunvalley.co.kr/mypage/reservation" />

    <!-- Sun Valley navigation / bounded-refresh state machine -->
    <add key="DiagnosticMode" value="true" />
    <add key="MaxRefresh" value="40" />
    <add key="RefreshDelayMs" value="1500" />
    <add key="MaxWaitSeconds" value="180" />
    <add key="DiagnosticsDir" value="diagnostics" />

    <!-- Local QA only: when enabled, navigation is restricted to this file:// fixture
         directory (login.html, reservation/golf.html, history.html). Keep disabled
         in normal builds. -->
    <add key="DummyTestMode" value="false" />
    <add key="DummyBaseUrl" value="" />
  </appSettings>
</configuration>
