<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>14.0</LangVersion>
    <AssemblyName>StartValidation</AssemblyName>
    <RootNamespace>StartValidation</RootNamespace>
    <DefineConstants>$(DefineConstants);DIAGNOSTIC_BUILD</DefineConstants>
    <NoWarn>$(NoWarn);CS0108;CS0114;CS0162;CS0164;CS0168;CS0169;CS0219;CS0414;CS0472;CS0649;CS1717;CS8321</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\booking\booking.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="StartValidation.dll.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
